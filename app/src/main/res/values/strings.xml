    <!-- Data sources -->
    <string name="sources_title">Data sources</string>
    <string name="sources_intro">Earth Now shows real data from public science sources. Each layer\'s source, update frequency and licensing are listed below. When a source has no data, the app says \"Data unavailable\" — it never fabricates values.</string>
    <string name="source_label">Source</string>
    <string name="update_label">Update</string>
    <string name="license_label">License</string>
    <string name="license_openmeteo">CC BY 4.0 (Open-Meteo) · model data from national weather services</string>
    <string name="license_rainviewer">RainViewer API — free for personal/educational use; attribution required</string>
    <string name="license_usgs">USGS public domain; attribution requested</string>
    <string name="license_firms">NASA FIRMS — free MAP_KEY required; NASA attribution required</string>
    <string name="license_gvp">Smithsonian GVP database — cite: Global Volcanism Program, Volcanoes of the World. Static catalog; not real-time.</string>
    <string name="license_noaa">NOAA SWPC — public domain; attribution requested</string>
    <string name="license_calculated">Calculated from solar ephemeris (astronomical algorithm)</string>
    <string name="wildfire_key_note">Note: requires a free NASA FIRMS MAP_KEY in local.properties. Without it this layer shows \"Data unavailable\".</string>
    <string name="basemaps_title">🗺️ Basemaps</string>
    <string name="basemap_space">OpenFreeMap vector basemap with in-app dark colors — © OpenFreeMap, © OpenStreetMap contributors</string>
    <string name="basemap_satellite">Sentinel-2 cloudless © EOX (WMTS, keyless)</string>
    <string name="basemap_streets">© OpenStreetMap contributors (ODbL)</string>
    <string name="basemap_cached">MapLibre caches tiles locally only for rendering. No tile redistribution.</string>
    <string name="ai_source_title">🤖 AI</string>
    <string name="ai_source_provider">OpenAI-compatible or Google Gemini (configurable), or local template fallback</string>
    <string name="ai_source_data">Only the structured real data shown in the app — never invented facts</string>
    <string name="ai_source_safety">The AI never gives definitive hazard advice; it points to local official authorities</string>

    <!-- Onboarding -->
    <string name="onb1_title">See the Earth Live</string>
    <string name="onb1_body">A real 3D globe of our planet. Spin it, zoom in, and explore what is happening right now anywhere on Earth.</string>
    <string name="onb2_title">Live data layers</string>
    <string name="onb2_body">Temperature, clouds, wind, precipitation, ocean temperature, earthquakes, wildfires, volcanoes and the aurora — all from real scientific sources.</string>
    <string name="onb3_title">Ask AI what\'s happening anywhere</string>
    <string name="onb3_body">Tap any point and ask: what\'s happening here? The AI answers using the real data on your screen — never invented facts.</string>
    <string name="onb4_title">Explore the world</string>
    <string name="onb4_body">Search for cities, countries, volcanoes and oceans. Save favorites, watch regions, and share live snapshots.</string>
    <string name="onb_next">Next</string>
    <string name="onb_back">Back</string>
